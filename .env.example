# ==============================================================================
# LEETVERSE MOM GENERATOR - FRONTEND CONFIGURATION
# ==============================================================================
# NOTE: Because this frontend is static vanilla HTML/CSS/JS running directly in
# the browser, client-side JavaScript cannot read `.env` files at runtime.
#
# These values are placed in `config.js` which is loaded before `script.js`.
# Use this file as a reference when filling in `config.js`.

# 1. Backend MOM API URL:
# - Local full backend server:  http://localhost:5000/mom
# - Local test harness server:  http://localhost:4010/mom
# - Production deployed API:    https://api.leetverse.in/mom
MOM_API_BASE=http://localhost:5000/mom

# 2. Firebase Web Application Credentials
# (Found in: Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
FIREBASE_API_KEY=AIzaSyYOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=leetverse-website.firebaseapp.com
FIREBASE_PROJECT_ID=leetverse-website
FIREBASE_STORAGE_BUCKET=leetverse-website.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

